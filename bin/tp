#!/bin/bash

CODE_DIR="$HOME/Code"

command -v fzf  >/dev/null 2>&1 || { echo "fzf is required but not installed."; exit 1; }
command -v tmux >/dev/null 2>&1 || { echo "tmux is required but not installed."; exit 1; }
[ -d "$CODE_DIR"         ] || { echo "$CODE_DIR does not exist.";         exit 1; }

entries=()

if [ -d "$CODE_DIR/projects" ]; then
    for dir in "$CODE_DIR/projects"/*/; do
        [ -d "$dir" ] && entries+=("projects/$(basename "$dir")")
    done
fi

for special in dotfiles homelab; do
    [ -d "$CODE_DIR/$special" ] && entries+=("$special")
done

[ ${#entries[@]} -eq 0 ] && { echo "No projects found."; exit 1; }

selected=$(printf '%s\n' "${entries[@]}" | fzf --prompt="tp → " --exit-0)
[ -z "$selected" ] && exit 0

case "$selected" in
    projects/*)
        session_name="${selected#projects/}"
        project_path="$CODE_DIR/$selected"
        ;;
    *)
        session_name="$selected"
        project_path="$CODE_DIR/$selected"
        ;;
esac

if tmux has-session -t "$session_name" 2>/dev/null; then
    tmux attach -t "$session_name"
else
    tmux new-session -s "$session_name" -c "$project_path"
fi
